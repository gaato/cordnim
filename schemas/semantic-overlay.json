{
  "revision": 3,
  "description": "Semantic corrections applied after parsing Discord's preview OpenAPI document.",
  "rules": [
    {
      "target": "#/components/schemas/SnowflakeType",
      "semantic": "snowflake",
      "representation": "decimal-string-at-json-boundary",
      "reason": "Snowflakes are unsigned 64-bit domain identifiers even when the schema accepts an integer representation."
    },
    {
      "target": [
        "#/components/schemas/ApplicationOAuth2InstallParams/properties/permissions",
        "#/components/schemas/ApplicationOAuth2InstallParamsResponse/properties/permissions",
        "#/components/schemas/CreateRoleRequest/properties/permissions",
        "#/components/schemas/CreatedThreadResponse/properties/permissions",
        "#/components/schemas/GuildChannelResponse/properties/permissions",
        "#/components/schemas/GuildRoleResponse/properties/permissions",
        "#/components/schemas/GuildTemplateRoleResponse/properties/permissions",
        "#/components/schemas/InviteGuildRoleResponse/properties/permissions",
        "#/components/schemas/MyGuildResponse/properties/permissions",
        "#/components/schemas/PrivateGuildMemberResponse/properties/permissions",
        "#/components/schemas/ThreadResponse/properties/permissions",
        "#/components/schemas/UpdateRoleRequestPartial/properties/permissions"
      ],
      "semantic": "extensible-bits",
      "representation": "decimal-string-arbitrary-width",
      "reason": "Permission values must preserve bits unknown to this schema revision."
    },
    {
      "target": "**/properties/flags_new",
      "semantic": "extensible-bits",
      "representation": "decimal-string-arbitrary-width",
      "reason": "flags_new carries flag values that cannot be represented by the legacy fixed-width field."
    },
    {
      "target": "#/components/schemas/*PatchRequestPartial",
      "semantic": "patch-object",
      "representation": "unset-null-value",
      "reason": "Omission and explicit JSON null have different PATCH behavior."
    },
    {
      "target": "**/x-discord-union",
      "semantic": "exclusive-union",
      "representation": "one-of",
      "reason": "Discord documents x-discord-union anyOf declarations as exclusive alternatives."
    },
    {
      "target": [
        "#/components/schemas/**/enum",
        "#/paths/~1lobbies/post/requestBody/content/application~1json/schema/properties/flags/oneOf/1/enum",
        "#/paths/~1lobbies/put/requestBody/content/application~1json/schema/properties/flags/oneOf/1/enum",
        "#/paths/~1lobbies~1{lobby_id}/patch/requestBody/content/application~1json/schema/properties/flags/oneOf/1/enum",
        "#/paths/~1lobbies~1{lobby_id}~1members~1{user_id}/put/requestBody/content/application~1json/schema/properties/flags/oneOf/1/enum"
      ],
      "semantic": "open-enum",
      "representation": "raw-value-plus-known-view",
      "reason": "Unknown enum values must survive decoding and re-encoding."
    },
    {
      "target": "**/properties/allow|**/properties/deny",
      "semantic": "extensible-bits",
      "representation": "decimal-string-arbitrary-width",
      "reason": "Permission overwrite values have the same future-width contract as permissions."
    },
    {
      "target": "#/components/schemas/MessageEditRequestPartial",
      "semantic": "irreversible-components-v2-transition",
      "representation": "separate-legacy-and-v2-types",
      "reason": "IS_COMPONENTS_V2 cannot be unset and legacy content, embeds, stickers, and polls must be cleared during the upgrade."
    },
    {
      "target": "#/components/schemas/*ComponentForMessageRequest",
      "semantic": "legal-component-tree",
      "representation": "validated-parent-child-tree-max-40",
      "reason": "OpenAPI unions do not express every nesting, cardinality, target exclusivity, or total component-count rule."
    },
    {
      "target": "#/components/schemas/*ComponentForModalRequest",
      "semantic": "modal-label-tree",
      "representation": "typed-form-schema-and-decoder",
      "reason": "Modal-only components, Label wrappers, submitted values, and resolved entities require form-specific validation."
    }
  ],
  "constraints": {
    "preserveUnknownObjectFields": true,
    "preserveUnknownEnumValues": true,
    "preserveUnknownFlagBits": true,
    "treatOptionalAndNullableSeparately": true,
    "componentsV2Irreversible": true,
    "maximumMessageComponents": 40,
    "legacyAndV2MessageFieldsExclusive": true
  }
}
